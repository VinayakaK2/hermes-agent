# =============================================================================
# 1. RENDER & DASHBOARD WEB UI (Mandatory)
# =============================================================================
PORT=8000
HERMES_DASHBOARD=true
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=8000
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=5002112A
HERMES_HOME=/opt/data
PYTHONUNBUFFERED=1

# =============================================================================
# 2. PERSISTENCE & ZERO DATA LOSS (Hugging Face Private Storage)
# =============================================================================
# Hugging Face write token daalein (Render Dashboard mein add karein)
HF_TOKEN=
HF_DATASET_ID=VinayakaK/hermes-storage

# =============================================================================
# 3. CODE EXECUTION & CLOUD SANDBOX (E2B / Modal)
# =============================================================================
# e2b.dev se free key daalein code run/build aur browser testing ke liye
E2B_API_KEY=
TERMINAL_TIMEOUT=120
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# 4. CONTEXT MEMORY COMPRESSION (Auto-shrinks long conversations)
# =============================================================================
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_THRESHOLD=0.85

# =============================================================================
# 5. BROWSER SESSIONS AUTO-CLEANUP (Saves Memory)
# =============================================================================
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120
